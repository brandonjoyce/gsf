        <!-- Performances -->
        <h3 class="text-xl font-bold text-gray-900 mb-4">Live Performances</h3>
        <p class="text-gray-600 mb-6">Enjoy entertainment from Green Local Schools students!</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-gradient-to-br from-primary-50 to-accent-50 rounded-lg p-6 text-center border border-primary-200">
                <div class="w-14 h-14 bg-white rounded-full flex items-center justify-center mx-auto mb-3 shadow">
                    <svg class="w-7 h-7 text-primary-600" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                    </svg>
                </div>
                <h4 class="font-bold text-gray-900">6th Grade Choir</h4>
            </div>
            <div class="bg-gradient-to-br from-primary-50 to-accent-50 rounded-lg p-6 text-center border border-primary-200">
                <div class="w-14 h-14 bg-white rounded-full flex items-center justify-center mx-auto mb-3 shadow">
                    <svg class="w-7 h-7 text-primary-600" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z"/>

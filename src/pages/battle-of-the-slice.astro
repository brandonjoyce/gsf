---
import ContentLayout from "../layouts/ContentLayout.astro";
---

<ContentLayout
    title="Battle of the Slice | February 28th at The CORE"
    description="Join us February 28th for Green's Battle of the Slice! Sample pizzas from local favorites, enjoy ice cream, activities for all ages, and support student scholarships. All proceeds benefit the Green Schools Foundation."
    showBreadcrumbs={true}
    showHero={false}
    image="/images/Battle of the Slice.jpg?v=2"
    breadcrumbs={[
        { name: "Events", href: "/events" },
        { name: "Battle of the Slice", href: "/battle-of-the-slice" }
    ]}
>
    <!-- Sticky Buy Tickets Button -->
    <div class="fixed bottom-6 right-6 z-50">
        <a href="#tickets" class="inline-flex items-center justify-center px-6 py-4 text-lg font-bold text-white bg-primary-600 hover:bg-primary-700 rounded-full shadow-lg hover:shadow-xl transition-all transform hover:scale-105 animate-pulse hover:animate-none">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>
            </svg>
            <span>Buy Tickets</span>
        </a>
    </div>

    <!-- Hero Section with Logo -->
    <div class="text-center mb-12">
        <img
            src="/images/Battle of the Slice.jpg?v=2"
            alt="Green's Battle of the Slice - Presented by GSF Green Schools Foundation"
            class="mx-auto max-w-2xl w-full mb-8"
        />
        <p class="text-xl text-gray-700 max-w-2xl mx-auto">
            Taste your way through the city's best pizzas, enjoy games and activities for all ages, and support student success — one delicious slice at a time! All proceeds support scholarships, grants, and programs through the Green Schools Foundation.
        </p>
    </div>

    <!-- ============================================ -->
    <!-- SECTION 1: About the Event & Participating Businesses -->
    <!-- ============================================ -->
    <div class="content-section">
        <h2>About the Event</h2>
        <p class="text-gray-700 mb-6">
            Battle of the Slice is a community celebration bringing together local pizzerias, ice cream shops, family activities, and live performances. The Green Schools Foundation is proud to support this event, with all proceeds benefiting scholarships, academic classroom grants, and educational programs for Green students. Join us for a day of delicious food, fun activities, and community spirit!
        </p>
        <ul class="space-y-3 text-gray-700 mb-8">
            <li class="flex items-start">
                <svg class="w-5 h-5 text-primary-500 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
        <span><strong>Location:</strong> <a href="https://maps.app.goo.gl/3MThiNGhZ49SAV9m6" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:text-primary-700">Green Middle School/CORE building</a></span>
            </li>
            <li class="flex items-start">
                <svg class="w-5 h-5 text-primary-500 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span><strong>Main Cafeteria:</strong> Pizza vendors and food service</span>
            </li>
            <li class="flex items-start">
                <svg class="w-5 h-5 text-primary-500 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
        <span><strong>Middle School Gym:</strong> Activities, entertainment, and bounce house</span>
            </li>
            <li class="flex items-start">
                <svg class="w-5 h-5 text-primary-500 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span><strong>CORE Gym:</strong> Bounce house and business booths</span>
            </li>
            <li class="flex items-start">
                <svg class="w-5 h-5 text-primary-500 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span><strong>CORE Turf Field:</strong> High school sports clinics</span>
            </li>
            <li class="flex items-start bg-red-50 border border-red-200 rounded-lg p-3 -mx-3">
                <svg class="w-5 h-5 text-red-500 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                <span class="text-red-800 font-semibold"><strong>Tickets:</strong> Must be purchased in advance — no ticket sales at the door!</span>
            </li>
        </ul>

        <!-- Pizza Shops -->
        <h3 class="text-xl font-bold text-gray-900 mb-4">Participating Pizza Shops</h3>
    <p class="text-gray-600 mb-6">Sample slices includes favorites like these local pizzerias and vote for your favorite!</p>

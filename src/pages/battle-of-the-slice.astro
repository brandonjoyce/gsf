    <!-- ============================================ -->
    <!-- SECTION 2: Green Area Chamber -->
    <!-- ============================================ -->
    <div class="highlight-box mb-12">
        <div class="flex flex-col md:flex-row items-center gap-6">
            <div class="flex-shrink-0">
                <div class="w-32 h-32 bg-white rounded-lg shadow flex items-center justify-center p-2">
                    <img src="/images/logos/green-chamber-logo.jpg?v=022026" alt="Green Area Chamber of Commerce" class="max-h-full max-w-full object-contain" />
                </div>
            </div>
            <div class="flex-1 text-center md:text-left">
                <h2 class="text-2xl font-bold text-primary-600 mb-4">Green Area Chamber of Commerce</h2>
                <p class="text-gray-700 mb-4">
                    The Green Area Chamber is proud to partner with the Green Schools Foundation, Green Local Schools, and the City of Green for this community event. The Chamber is coordinating all of the tables this year and we are very excited to be a part of this collaboration!
                </p>
                <p class="text-gray-700 italic mb-6">
                    "Taste your way through the city's best pizzas, enjoy games and activities for all ages, and support student success—one delicious slice at a time!"
                </p>
                <div class="bg-white rounded-lg p-4 border border-gray-200">
                    <h3 class="font-semibold text-gray-900 mb-2">Business Table Opportunity</h3>
                    <p class="text-gray-600 text-sm mb-4">

                    <img src="/images/logos/handels-logo.png" alt="Handel's Ice Cream" class="max-h-full max-w-full object-contain" />
                </div>
                <span class="text-xs text-primary-600">Visit Website →</span>
            </a>
            <a href="https://www.dairyqueen.com/" target="_blank" rel="noopener noreferrer" class="bg-white rounded-lg shadow-md p-4 text-center hover:shadow-lg transition-shadow border border-gray-200 hover:border-primary-300">
                <div class="h-16 flex items-center justify-center mb-2">
                    <img src="/images/logos/dairy-queen-logo.png" alt="Dairy Queen" class="max-h-full max-w-full object-contain" />
                </div>
                <span class="text-xs text-primary-600">Visit Website →</span>
            </a>
            <a href="https://www.waylonshandcrafted.com/" target="_blank" rel="noopener noreferrer" class="bg-white rounded-lg shadow-md p-4 text-center hover:shadow-lg transition-shadow border border-gray-200 hover:border-primary-300">
                <div class="h-16 flex items-center justify-center mb-2">
                    <img src="/images/logos/waylons-logo.jpg" alt="Waylon's Handcrafted" class="max-h-full max-w-full object-contain" />
                </div>
                <span class="text-xs text-primary-600">Visit Website →</span>
            </a>
            <a href="https://www.instagram.com/sicilysitalianicebox/" target="_blank" rel="noopener noreferrer" class="bg-white rounded-lg shadow-md p-4 text-center hover:shadow-lg transition-shadow border border-gray-200 hover:border-primary-300">
                <div class="h-16 flex items-center justify-center mb-2">
                    <img src="/images/logos/sicilys-logo.jpg" alt="Sicily's Italian Icebox" class="max-h-full max-w-full object-contain" />
                </div>
                <span class="text-xs text-primary-600">Visit Instagram →</span>
            </a>
        </div>

        <!-- Coffee -->
        <h3 class="text-xl font-bold text-gray-900 mb-4">Coffee & Beverages</h3>
        <p class="text-gray-600 mb-6">Need a pick-me-up? Grab your favorite coffee drinks!</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
            <a href="https://maps.app.goo.gl/eUzxaLDZjA4vqaeb6" target="_blank" rel="noopener noreferrer" class="bg-white rounded-lg shadow-md p-6 flex items-center gap-6 hover:shadow-lg transition-shadow border border-gray-200 hover:border-primary-300">
                <div class="w-20 h-20 flex-shrink-0 flex items-center justify-center">
                    <img src="/images/logos/starbucks-logo.png" alt="Starbucks" class="max-h-full max-w-full object-contain" />
                </div>
                <div class="text-left">
                    <h4 class="font-bold text-gray-900 mb-1">Starbucks</h4>
                    <p class="text-sm text-gray-600 mb-2">Your favorite Starbucks beverages will be available at the event!</p>
                    <span class="text-xs text-primary-600">View Location →</span>
                </div>
            </a>
        </div>

        <!-- Activities -->
        <h3 class="text-xl font-bold text-gray-900 mb-4">Activities for All Ages</h3>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-10">
            <div class="bg-white rounded-lg overflow-hidden shadow-md border border-gray-200 hover:shadow-lg transition-shadow">
                <div class="h-40 overflow-hidden">
                    <img src="/images/battle-of-slice/bounce-house.webp" alt="Kids enjoying bounce houses" class="w-full h-full object-cover" />
                </div>
                <div class="p-3 text-center bg-yellow-50 border-t border-yellow-200">
                    <span class="font-semibold text-gray-800">Bounce Houses</span>
                </div>
            </div>
            <div class="bg-white rounded-lg overflow-hidden shadow-md border border-gray-200 hover:shadow-lg transition-shadow">
                <div class="h-40 overflow-hidden">
                    <img src="/images/battle-of-slice/balloon-art.webp" alt="Colorful balloon art creations" class="w-full h-full object-cover" />
                </div>
                <div class="p-3 text-center bg-pink-50 border-t border-pink-200">
                    <span class="font-semibold text-gray-800">Balloon Art</span>
                </div>
            </div>
            <div class="bg-white rounded-lg overflow-hidden shadow-md border border-gray-200 hover:shadow-lg transition-shadow">
                <div class="h-40 overflow-hidden">
                    <img src="/images/battle-of-slice/face-painting.webp" alt="Child with colorful butterfly face paint" class="w-full h-full object-cover object-[center_35%]" />
                </div>
                <div class="p-3 text-center bg-purple-50 border-t border-purple-200">
                    <span class="font-semibold text-gray-800">Face Painting</span>
                </div>
            </div>
            <div class="bg-white rounded-lg overflow-hidden shadow-md border border-gray-200 hover:shadow-lg transition-shadow">
                <div class="h-40 overflow-hidden">
                    <img src="/images/battle-of-slice/laser-tag.png" alt="Kids playing laser tag" class="w-full h-full object-cover" />
                </div>
                <div class="p-3 text-center bg-orange-50 border-t border-orange-200">
                    <span class="font-semibold text-gray-800">Laser Tag</span>
                </div>
            </div>
            <div class="bg-white rounded-lg overflow-hidden shadow-md border border-gray-200 hover:shadow-lg transition-shadow">
                <div class="h-40 overflow-hidden">
                    <img src="/images/battle-of-slice/club-activities.webp" alt="Green Robotics Club display" class="w-full h-full object-cover" />
                </div>
                <div class="p-3 text-center bg-green-50 border-t border-green-200">
                    <span class="font-semibold text-gray-800">High School Club Activities</span>
                </div>
            </div>
            <div class="bg-white rounded-lg overflow-hidden shadow-md border border-gray-200 hover:shadow-lg transition-shadow">
                <div class="h-40 overflow-hidden">
                    <img src="/images/battle-of-slice/sports-clinics.webp" alt="High school sports clinics for kids" class="w-full h-full object-cover" />

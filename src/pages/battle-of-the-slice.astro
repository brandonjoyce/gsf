            <a href="https://dechecospizzeria.com/" target="_blank" rel="noopener noreferrer" class="bg-white rounded-lg shadow-md p-4 text-center hover:shadow-lg transition-shadow border border-gray-200 hover:border-primary-300">
                <div class="h-16 flex items-center justify-center mb-2">
                    <img src="/images/logos/dechecos-logo.webp" alt="DeCheco's" class="max-h-full max-w-full object-contain" />
                </div>
                <span class="text-xs text-primary-600">Visit Website →</span>
            </a>
            <a href="https://www.parkstreetpizza.com/" target="_blank" rel="noopener noreferrer" class="bg-white rounded-lg shadow-md p-4 text-center hover:shadow-lg transition-shadow border border-gray-200 hover:border-primary-300">
                <div class="h-16 flex items-center justify-center mb-2">
                    <img src="/images/logos/park-street-pizza-logo.png?v=2" alt="Park Street Pizza" class="max-h-full max-w-full object-contain" />
                </div>
                <span class="text-xs text-primary-600">Visit Website →</span>
            </a>
            <a href="https://www.gioninos.com/" target="_blank" rel="noopener noreferrer" class="bg-white rounded-lg shadow-md p-4 text-center hover:shadow-lg transition-shadow border border-gray-200 hover:border-primary-300">
                <div class="h-16 flex items-center justify-center mb-2">
                    <img src="/images/logos/gioninos-logo.png" alt="Gionino's Pizzeria" class="max-h-full max-w-full object-contain" />
                </div>
                <span class="text-xs text-primary-600">Visit Website →</span>
            </a>
            <a href="https://upperdeckbarandgrill.com/" target="_blank" rel="noopener noreferrer" class="bg-white rounded-lg shadow-md p-4 text-center hover:shadow-lg transition-shadow border border-gray-200 hover:border-primary-300">
                <div class="h-16 flex items-center justify-center mb-2">
                    <img src="/images/logos/upperdeck-logo.png" alt="Upper Deck Bar and Grill" class="max-h-full max-w-full object-contain" />
                </div>
                <span class="text-xs text-primary-600">Visit Website →</span>
            </a>
            <a href="https://www.papajohns.com/" target="_blank" rel="noopener noreferrer" class="bg-white rounded-lg shadow-md p-4 text-center hover:shadow-lg transition-shadow border border-gray-200 hover:border-primary-300">
                <div class="h-16 flex items-center justify-center mb-2">
                    <img src="/images/logos/papa-johns-logo.png" alt="Papa John's" class="max-h-full max-w-full object-contain" />
                </div>
                <span class="text-xs text-primary-600">Visit Website →</span>
            </a>
            <a href="https://www.howlinbird.com/" target="_blank" rel="noopener noreferrer" class="bg-white rounded-lg shadow-md p-4 text-center hover:shadow-lg transition-shadow border border-gray-200 hover:border-primary-300">
                <div class="h-16 flex items-center justify-center mb-2">
                    <img src="/images/logos/howlin-bird-logo.webp" alt="The Howlin' Bird" class="max-h-full max-w-full object-contain" />
                </div>
                <span class="text-xs text-primary-600">Visit Website →</span>
            </a>
            <a href="https://www.sluggers-putters.com/" target="_blank" rel="noopener noreferrer" class="bg-white rounded-lg shadow-md p-4 text-center hover:shadow-lg transition-shadow border border-gray-200 hover:border-primary-300">
                <div class="h-16 flex items-center justify-center mb-2">
                    <img src="/images/logos/sluggers-putters-logo.png" alt="Sluggers & Putters" class="max-h-full max-w-full object-contain" />
                </div>
                <span class="text-xs text-primary-600">Visit Website →</span>
            </a>
        </div>
        <p class="text-center text-gray-500 italic -mt-6 mb-10">...and more to come!</p>

        <!-- Ice Cream Shops -->
        <h3 class="text-xl font-bold text-gray-900 mb-4">Ice Cream & Desserts</h3>
        <p class="text-gray-600 mb-6">Cool down with sweet treats from these local favorites!</p>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 mb-10">
            <a href="https://www.pavscreamery.com/" target="_blank" rel="noopener noreferrer" class="bg-white rounded-lg shadow-md p-4 text-center hover:shadow-lg transition-shadow border border-gray-200 hover:border-primary-300">
